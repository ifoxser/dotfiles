#!/bin/sh

commit_msg_file=$1

# ANSI color codes
GREEN=$(printf '\033[0;32m')
RED=$(printf '\033[0;31m')
YELLOW=$(printf '\033[0;33m')
BOLD=$(printf '\033[1m')
RESET=$(printf '\033[0m')

# Initialize and store the full commit message, excluding comment lines
full_message=''
if [ -f "$commit_msg_file" ]; then
    full_message=$(grep -v '^#' "$commit_msg_file" | sed '/^$/d')
fi

# Only check the first line
first_line=$(head -n1 "$commit_msg_file")

# Valid types
types="feat|fix|docs|style|refactor|conf|test|chore"

# Valid scopes
scopes="nvim|vscode|idea|tmux|alacritty|kitty|wezterm|zsh|bash|fish|git|github|gitlab|other"

# Commit message format regex
format_regex="^(${types})\((${scopes})\): .+"

# Function to print commit message
print_commit_message() {
    echo
    echo "${BOLD}=== Your Commit Message ===${RESET}"
    echo "$full_message"
    echo "${BOLD}===========================${RESET}"
    echo
}

# Always print the commit message first
print_commit_message

if ! echo "$first_line" | grep -qE "$format_regex"; then
    echo "${RED}${BOLD}× ERROR: Invalid commit message format in subject line.${RESET}"
    echo "${BOLD}Format: <type>(<scope>): <subject>${RESET}"
    echo
    echo "${BOLD}Valid types: ${types}${RESET}"
    echo "${BOLD}Valid scopes: ${scopes}${RESET}"
    echo
    echo "${BOLD}Examples:${RESET}"
    echo "  ${YELLOW}conf(zsh): update plugin settings${RESET}"
    echo "  ${YELLOW}fix(tmux): resolve session restore issue${RESET}"
    echo "  ${YELLOW}feat(nvim): add new plugin configuration${RESET}"
    exit 1
fi

# Only check the length of the first line
if [ ${#first_line} -gt 80 ]; then
    echo "${RED}${BOLD}ERROR: Subject line too long (max 80 characters)${RESET}"
    exit 1
fi

# If we get here, the commit message is valid
echo "${GREEN}${BOLD}✓ Commit message format is valid!${RESET}"
exit 0
