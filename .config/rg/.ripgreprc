# Search hidden files and directories.
--hidden

# Don't use ignore files from source control.
--no-ignore-vcs

# Because who cares about case!?
--smart-case

# Using glob patterns to include/exclude files or folders
# directories
--glob=!**/.git/**
--glob=!**/.git*/**
--glob=!**/.repo/**
--glob=!**/.cache/**
--glob=!**/_cacache/**
--glob=!**/.vscode-server/**
# files
--glob=!**/.git*
--glob=!**/*.o
--glob=!**/*.cmd
--glob=!**/*.arm.d
--glob=!**/*.arm.o
--glob=!**/*.mod
--glob=!**/*.mod.c

# Limit the displayed line length to 1000 characters
--max-columns=800

# Show preview of truncated lines
--max-columns-preview
