#!/bin/bash

# Path to PlantUML JAR file and its config file
PLANTUML_JAR="$HOME/.local/bin/plantuml.jar"
CONFIG_FILE="$HOME/.local/bin/plantuml.config"

# Java options: set maximum diagram size to 50000 pixels
JAVA_OPTS=("-DPLANTUML_LIMIT_SIZE=50000")

# Supported file extensions for PlantUML diagrams
SUPPORTED_EXT="(puml|plantuml|pu|uml)"

# ANSI color codes for terminal output
GREEN='\033[0;32m'
RED='\033[0;31m'
NC='\033[0m'

# param 1: file path to check and gen target
# param 2: boolean flag indicating if this is the last file (for output formatting)
check_and_gen_file() {
    local file="$1"
    local is_last="$2"

    # Get file extension and check if it's supported
    local ext="${file##*.}"
    if [[ ! "$ext" =~ ^${SUPPORTED_EXT}$ ]]; then
        return 0
    fi

    echo "==> Checking $file:"

    # Run PlantUML syntax check
    # Pipe file content to PlantUML jar and capture output
    # 2>&1: Redirect error output to standard output
    local result
    result=$(java "${JAVA_OPTS[@]}" -jar "$PLANTUML_JAR" -syntax -stdrpt:1 <"$file" 2>&1)
    local exit_code=$? # Store command exit status
    if [ -n "$result" ]; then
        echo "$result"
    fi

    # Generate diagram if syntax check passed, otherwise print error
    local filename
    filename=$(basename "$file")
    if [ $exit_code -eq 0 ]; then
        java "${JAVA_OPTS[@]}" -jar "$PLANTUML_JAR" -config "$CONFIG_FILE" "$file"
        echo -e "${GREEN}${filename}: Generation successful${NC}"
    else
        echo -e "${RED}${filename}: Generation failed${NC}"
    fi

    # Add empty line for formatting if not the last file
    if [ "$is_last" != "true" ]; then
        echo
    fi

    return $exit_code
}

# Function to process directory
# Param: directory path
check_and_gen_directory() {
    local dir="$1"
    local files=() # Array to store found files

    # Find all PlantUML files in directory
    readarray -t files < <(find "$dir" -maxdepth 1 -type f -regextype posix-extended -regex ".*\.${SUPPORTED_EXT}")

    # Count total and current files
    local total=${#files[@]}
    local count=0

    # Process each file
    for file in "${files[@]}"; do
        ((count++))
        local is_last=false
        [ "$count" -eq "$total" ] && is_last=true
        if ! check_and_gen_file "$file" "$is_last"; then # Process file and set overall status to 1 if failed
            overall_status=1
        fi
    done
}

plantuml_main() {
    # Check if arguments are provided
    if [ "$#" -eq 0 ]; then
        echo "Usage: $(basename "$0") <file.puml | directory | pattern>"
        echo "Supported extensions: .puml, .plantuml, .pu, .uml"
        exit 1
    fi

    # Initialize status and argument counters
    overall_status=0
    total_args=$#
    arg_count=0

    # Process each argument (file, directory, or pattern)
    for pattern in "$@"; do
        ((arg_count++))
        is_last=false
        [ $arg_count -eq $total_args ] && is_last=true

        # Error if file not found and no wildcards used
        if [[ ! -e "$pattern" && ! "$pattern" =~ [\*\?] ]]; then
            echo "Error: File not found - $pattern"
            overall_status=1
            continue
        fi

        if [ -d "$pattern" ]; then
            check_and_gen_directory "$pattern"
        elif [ -f "$pattern" ]; then
            if ! check_and_gen_file "$pattern" "$is_last"; then
                overall_status=1
            fi
        else
            # Handle wildcard patterns (*.puml etc)
            # Note: Shell keeps original pattern string if no matches found

            # Handle wildcard patterns safely
            IFS=' ' read -r -a files <<<"$(compgen -G "$pattern")"

            # Exit if no matching files found
            if [ "${files[0]}" = "$pattern" ] && [ ! -e "$pattern" ]; then
                echo "Error: File not found - $pattern"
                overall_status=1
                continue
            fi

            # Get total number of files matched by the wildcard pattern
            total=${#files[@]}
            count=0

            # Iterate through each matched file in the array
            for file in "${files[@]}"; do
                if [ -f "$file" ]; then
                    ((count++))
                    local is_last_file=false
                    [ "$count" -eq "$total" ] && [ "$arg_count" -eq "$total_args" ] && is_last_file=true
                    if ! check_and_gen_file "$file" "$is_last_file"; then
                        overall_status=1
                    fi
                fi
            done
        fi
    done

    # Return exit status for the entire script execution
    # Exit code 0: All operations completed successfully
    # Exit code 1: One or more operations failed during execution
    exit $overall_status
}

plantuml_main "$@"
